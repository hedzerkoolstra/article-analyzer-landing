---
import LeaderboardRow from './LeaderboardRow.astro';
import SectionLabel from './SectionLabel.astro';
import type { Outlet } from '../data/fixtures';

interface Props {
  outlets: Outlet[];
}

const { outlets } = Astro.props;
const top = outlets.slice(0, 10);
const bottom = outlets.slice(-5);
---

<div class="leaderboard">
  <div class="leaderboard-cols">
    <span class="col-rank"><SectionLabel label="#" /></span>
    <span class="col-name"><SectionLabel label="Outlet" /></span>
    <span class="col-tag"><SectionLabel label="Most common" /></span>
    <span class="col-score"><SectionLabel label="Score" /></span>
  </div>

  {top.map((outlet) => <LeaderboardRow outlet={outlet} />)}

  <div class="relegation-divider"></div>

  {bottom.map((outlet) => <LeaderboardRow outlet={outlet} danger />)}

  <p class="leaderboard-caption">
    Rolling 6 months · updated weekly · <a href="/methodology">methodology →</a>
  </p>
</div>

<style>
  .leaderboard {
    width: 100%;
  }

  .leaderboard-cols {
    display: grid;
    grid-template-columns: 28px 1fr 160px 130px;
    gap: 16px;
    padding: 10px 0 8px;
    border-bottom: 1px solid var(--color-border-strong);
  }

  .col-rank { text-align: right; }
  .col-n { text-align: right; }
  .col-score { text-align: right; }

  .relegation-divider {
    border-top: 1px solid rgba(226, 75, 74, 0.2);
    margin-top: 4px;
  }

  .leaderboard-more {
    margin-top: 0;
  }

  .more-toggle {
    display: block;
    width: 100%;
    padding: 12px 0;
    font-size: 12px;
    color: var(--text-tertiary);
    cursor: pointer;
    list-style: none;
    border-bottom: 1px solid var(--color-border-default);
    transition: color 0.12s;
  }

  .more-toggle::-webkit-details-marker { display: none; }

  .more-toggle:hover {
    color: var(--text-secondary);
  }

  details[open] .more-toggle {
    border-bottom: none;
  }

  .leaderboard-caption {
    margin: 16px 0 0;
    font-size: 11px;
    color: var(--text-tertiary);
  }

  .leaderboard-caption a {
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color 0.12s;
  }

  .leaderboard-caption a:hover {
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .leaderboard-cols {
      grid-template-columns: 28px 1fr 130px;
    }
    .col-tag {
      display: none;
    }
  }
</style>
