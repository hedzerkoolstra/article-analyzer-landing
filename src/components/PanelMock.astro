---
const score = 22;
const filled = Math.round(score / 10);
const segments = Array.from({ length: 10 }, (_, i) => i < filled);
---

<div class="panel-mock">
  <div class="panel-header">
    <div class="panel-top-row">
      <span class="panel-wordmark">
        <span class="panel-pip" />· capito
      </span>
      <div class="panel-score-bar">
        {segments.map((active) => (
          <span class={`seg ${active ? "active" : ""}`} />
        ))}
      </div>
      <span class="panel-score-label">{score} / 100</span>
    </div>
    <p class="panel-verdict">selective framing, fear appeal, unnamed authority</p>
  </div>

  <div class="panel-findings">
    <p class="panel-findings-label">findings · 4</p>

    <div class="panel-finding">
      <div class="panel-finding-head">
        <span class="panel-type-tag"><span class="tag-pip" />Emotional manipulation</span>
        <span class="panel-slash">/</span>
        <span class="panel-subtype">fear appeal</span>
      </div>
      <p class="panel-quote">"Experts warn that if this policy passes, the consequences could be catastrophic for millions of families."</p>
      <p class="panel-label">catastrophising — unnamed experts, no evidence cited</p>
    </div>

    <div class="panel-finding">
      <div class="panel-finding-head">
        <span class="panel-type-tag"><span class="tag-pip" />Framing & omission</span>
        <span class="panel-slash">/</span>
        <span class="panel-subtype">selective framing</span>
      </div>
      <p class="panel-quote">"Every economist agrees this approach has failed everywhere it's been tried."</p>
      <p class="panel-label">false consensus — contradicts actual expert range</p>
    </div>
  </div>
</div>

<style>
  .panel-mock {
    width: 320px;
    background: var(--color-surface-deep);
    border: 0.5px solid var(--color-border-strong);
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255, 216, 77, 0.04),
      0 24px 48px rgba(0, 0, 0, 0.5),
      0 4px 12px rgba(0, 0, 0, 0.3);
    flex-shrink: 0;
  }

  .panel-header {
    padding: 14px 16px 12px;
    background: linear-gradient(180deg, var(--color-surface-header) 0%, transparent 100%);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .panel-top-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .panel-wordmark {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 11px;
    color: var(--text-tertiary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .panel-pip {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent-yellow);
    box-shadow: 0 0 6px var(--color-accent-yellow-focus);
    flex-shrink: 0;
  }

  .panel-score-bar {
    display: flex;
    gap: 2px;
    flex: 1;
  }

  .seg {
    flex: 1;
    height: 10px;
    border-radius: 1px;
    background: rgba(255, 255, 255, 0.06);
  }

  .seg.active {
    background: linear-gradient(90deg, #c8a424, var(--color-accent-yellow));
  }

  .panel-score-label {
    font-size: 9px;
    font-weight: 500;
    color: var(--text-tertiary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .panel-verdict {
    margin: 0;
    font-size: 11px;
    font-weight: 300;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .panel-findings {
    padding: 10px 0 4px;
  }

  .panel-findings-label {
    margin: 0 0 6px;
    padding: 0 16px;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .panel-finding {
    padding: 10px 16px;
    border-top: 0.5px solid var(--color-border-default);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .panel-finding-head {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .panel-type-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 8.5px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-accent-yellow-text);
    background: linear-gradient(135deg, rgba(255,216,77,0.13), rgba(255,216,77,0.06));
    border: 0.5px solid var(--color-accent-yellow-border);
    border-radius: 3px;
    padding: 2px 5px 2px 4px;
    white-space: nowrap;
  }

  .tag-pip {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-accent-yellow);
    flex-shrink: 0;
  }

  .panel-slash {
    font-size: 9px;
    color: var(--text-tertiary);
    opacity: 0.35;
  }

  .panel-subtype {
    font-size: 9px;
    font-weight: 300;
    letter-spacing: 0.02em;
    color: var(--text-tertiary);
  }

  .panel-quote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 11px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .panel-label {
    margin: 0;
    font-size: 10px;
    font-weight: 300;
    line-height: 1.4;
    color: var(--text-tertiary);
  }
</style>
