---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<span class="section-label">{label}</span>

<style>
  .section-label {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
</style>
