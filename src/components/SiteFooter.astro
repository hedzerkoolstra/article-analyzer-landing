<footer id="contact" class="site-footer">
  <div class="footer-col">
    <span>Capito © 2026</span>
    <a href="mailto:admin@capito.news">admin@capito.news</a>
    <a href="/privacy">Privacy</a>
  </div>
  <div class="footer-col footer-col-end">
    <span>Built and hosted in the EU</span>
    <span>No tracking cookies</span>
    <span>Analytics by <a class="external" href="https://plausible.io/privacy" target="_blank" rel="noopener noreferrer">Plausible</a></span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border-default);
    padding: 56px 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
    font-size: 12px;
    color: var(--text-tertiary);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col-end {
    text-align: right;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
    transition:
      color 0.12s,
      text-decoration-color 0.12s;
  }

  .site-footer a:hover {
    color: var(--text-primary);
  }

  .site-footer a.external {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(255, 255, 255, 0.35);
  }

  .site-footer a.external:hover {
    text-decoration-color: currentColor;
  }
</style>
