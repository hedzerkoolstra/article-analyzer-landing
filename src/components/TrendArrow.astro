---
interface Props {
  delta: number;
}
const { delta } = Astro.props;
---

{delta > 0 && (
  <span class="trend trend-up" aria-label={`Up ${delta}`}>
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
      <path d="M5 8V2M2 5l3-3 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    {delta}
  </span>
)}
{delta < 0 && (
  <span class="trend trend-down" aria-label={`Down ${Math.abs(delta)}`}>
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
      <path d="M5 2v6M2 5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    {Math.abs(delta)}
  </span>
)}
{delta === 0 && (
  <span class="trend trend-flat" aria-label="No change">—</span>
)}

<style>
  .trend {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 11px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .trend-up { color: var(--color-score-high); }
  .trend-down { color: var(--color-score-low); }
  .trend-flat { color: var(--text-tertiary); }
</style>
