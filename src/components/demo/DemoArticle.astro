---
import type { DemoAnalysis } from "../../data/demoAnalysis";

interface Props {
  analysis: DemoAnalysis;
}

const { analysis } = Astro.props;
---

<article class="article" data-demo-side="article">
  <header class="article-head">
    <p class="article-outlet">{analysis.outlet}</p>
    <h3 class="article-headline">{analysis.headline}</h3>
    <p class="article-meta">{analysis.byline} · {analysis.date}</p>
  </header>

  {
    analysis.paragraphs.map((paragraph) => (
      <p class="article-body">
        {paragraph.segments.map((segment) =>
          segment.findingId ? (
            <mark class="mark" data-finding-id={segment.findingId} role="button" tabindex="0">
              {segment.text}
            </mark>
          ) : (
            segment.text
          ),
        )}
      </p>
    ))
  }
</article>

<style>
  .article {
    flex: 1;
    min-width: 0;
    padding-right: 8px;
  }

  .article-head {
    padding-bottom: 18px;
    margin-bottom: 20px;
    border-bottom: 0.5px solid var(--color-border-default);
  }

  .article-outlet {
    margin: 0 0 12px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .article-headline {
    margin: 0 0 10px;
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .article-meta {
    margin: 0;
    font-size: 11px;
    font-weight: 300;
    color: var(--text-tertiary);
  }

  .article-body {
    margin: 0 0 16px;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .article-body:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .article {
      padding-right: 0;
    }

    .article-headline {
      font-size: 22px;
    }
  }

  .mark {
    background: var(--color-accent-yellow-soft);
    border-bottom: 1px solid var(--color-accent-yellow-active);
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s,
      color 0.15s;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .mark:hover,
  .mark.is-active {
    background: var(--color-accent-yellow-mid);
    border-bottom-color: var(--color-accent-yellow-bright);
    color: var(--text-primary);
  }

  .mark:focus-visible {
    outline: 1px solid var(--color-accent-yellow-focus);
    outline-offset: 2px;
  }
</style>
