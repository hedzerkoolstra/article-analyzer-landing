---
import PanelTag from "./PanelTag.astro";
import type { DemoFinding } from "../../data/demoAnalysis";

interface Props {
  finding: DemoFinding;
  quote: string;
}

const { finding, quote } = Astro.props;
---

<button
  type="button"
  class="finding"
  data-finding-id={finding.id}
  data-type-slug={finding.typeSlug}
  aria-pressed="false"
>
  <span class="finding-head">
    <PanelTag typeSlug={finding.typeSlug} typeLabel={finding.typeLabel} definition={finding.typeDefinition} />
    <span class="slash">/</span>
    <span class="subtype tooltip-host">
      {finding.subtypeLabel.toLowerCase()}
      <span class="tooltip-card" role="tooltip">
        <span class="tooltip-label">{finding.subtypeLabel}</span>
        <span class="tooltip-text">{finding.subtypeDefinition}</span>
      </span>
    </span>
  </span>
  <span class="quote">"{quote}"</span>
  <span class="verdict">{finding.verdict}</span>
</button>

<style>
  .finding {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    padding: 12px 16px;
    background: none;
    border: 0;
    border-top: 0.5px solid var(--color-border-default);
    font-family: var(--font-sans);
    text-align: left;
    cursor: pointer;
    transition: background 0.15s;
  }

  .finding[hidden] {
    display: none;
  }

  .finding:hover,
  .finding.is-active {
    background: var(--color-accent-yellow-soft);
  }

  .finding:focus-visible {
    outline: 1px solid var(--color-accent-yellow-focus);
    outline-offset: -1px;
  }

  .finding-head {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
  }

  .slash {
    font-size: 10px;
    color: var(--text-tertiary);
    opacity: 0.35;
  }

  .subtype {
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.02em;
    color: var(--text-tertiary);
    border-bottom: 0.5px dotted var(--color-border-strong);
  }

  .quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-secondary);
    transition: color 0.15s;
  }

  .verdict {
    font-size: 11px;
    font-weight: 300;
    line-height: 1.45;
    color: var(--text-tertiary);
    transition: color 0.15s;
  }

  .finding:hover .quote,
  .finding.is-active .quote {
    color: var(--text-primary);
  }

  .finding:hover .verdict,
  .finding.is-active .verdict {
    color: var(--text-secondary);
  }
</style>
