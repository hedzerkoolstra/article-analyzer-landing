---
import '../styles/global.css';
import BrowserCTA from '../components/BrowserCTA.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capito — Read without being played</title>
    <meta name="description" content="Capito detects propaganda techniques, framing, and logical fallacies in online articles. No politics. Just technique." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="page">

      <!-- Nav -->
      <nav class="nav">
        <span class="logo">Capito</span>
        <BrowserCTA />
      </nav>

      <!-- Hero -->
      <section class="hero">
        <p class="eyebrow">Browser extension</p>
        <h1 class="headline">Read without<br />being played.</h1>
        <p class="subhead">
          Capito flags propaganda techniques, logical fallacies, and framing in
          the articles you read — anchored to the exact passage, not just a
          vague verdict.
        </p>
        <div class="hero-actions">
          <BrowserCTA size="lg" />
        </div>
      </section>

      <!-- Three pillars -->
      <section class="pillars">
        <div class="pillar">
          <h3>Score at a glance</h3>
          <p>A credibility score (1–10) that measures how hard an article leans on manipulation — not which direction it leans.</p>
        </div>
        <div class="pillar">
          <h3>Pinned to the passage</h3>
          <p>Every finding is anchored to the exact quote. Hover a finding, the passage lights up. No ambiguity about where the spin is.</p>
        </div>
        <div class="pillar">
          <h3>Named and explained</h3>
          <p>Fear appeal, false dichotomy, ad hominem — every technique is named and explained. Capito shows the receipt, not just the bill.</p>
        </div>
      </section>

      <!-- No politics callout -->
      <section class="callout">
        <h2>No political axis.</h2>
        <p>
          Every other tool rates left vs. right. Capito ignores direction entirely
          and measures technique — how an article tries to influence you, not which
          way. That makes it usable across the political spectrum, by design.
        </p>
      </section>

      <!-- Pricing -->
      <section class="pricing">
        <h2>Pricing</h2>
        <div class="plans">
          <div class="plan">
            <div class="plan-name">Free</div>
            <div class="plan-price">€0</div>
            <div class="plan-desc">3 analyses / month. Full analysis every time — score, verdict, all findings. The gate is volume, not quality.</div>
            <a href="#" class="btn-primary">Get started</a>
          </div>
          <div class="plan plan-featured">
            <div class="plan-badge">Most popular</div>
            <div class="plan-name">Plus</div>
            <div class="plan-price">€4<span>/mo</span></div>
            <div class="plan-desc">30 analyses / month plus analysis history — every past article saved and searchable.</div>
            <a href="#" class="btn-primary">Get Plus</a>
          </div>
          <div class="plan">
            <div class="plan-name">Pro</div>
            <div class="plan-price">€16<span>/mo</span></div>
            <div class="plan-desc">300 analyses / month. For power users, journalists, and researchers who read a lot.</div>
            <a href="#" class="btn-primary">Get Pro</a>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="footer">
        <span>Capito © 2026</span>
        <span class="footer-tagline">Built by one person who finds propaganda funny.</span>
      </footer>

    </main>
  </body>
</html>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Nav */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-border-default);
  }

  .logo {
    font-weight: 600;
    font-size: 16px;
    color: var(--color-accent-yellow);
    letter-spacing: -0.01em;
  }


  /* Hero */
  .hero {
    padding: 80px 0 64px;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-yellow-text);
    margin: 0 0 20px;
  }

  .headline {
    font-size: clamp(40px, 7vw, 64px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 24px;
  }

  .subhead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 520px;
    margin: 0 0 40px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  /* Pillars */
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 64px 0;
    border-top: 1px solid var(--color-border-default);
  }

  @media (max-width: 600px) {
    .pillars {
      grid-template-columns: 1fr;
    }
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pillar h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .pillar p {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Callout */
  .callout {
    background: var(--color-accent-yellow-soft);
    border: 1px solid var(--color-accent-yellow-border);
    border-radius: 10px;
    padding: 40px;
    margin-bottom: 64px;
  }

  .callout h2 {
    margin: 0 0 12px;
    font-size: 24px;
    font-weight: 600;
    color: var(--color-accent-yellow);
    letter-spacing: -0.02em;
  }

  .callout p {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 520px;
  }

  /* Pricing */
  .pricing {
    padding-bottom: 80px;
  }

  .pricing h2 {
    margin: 0 0 32px;
    font-size: 24px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 600px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }

  .plan {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-default);
    border-radius: 10px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
  }

  .plan-featured {
    border-color: var(--color-accent-yellow-border);
    background: var(--color-accent-yellow-soft);
  }

  .plan-badge {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-yellow-text);
  }

  .plan-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .plan-featured .plan-name {
    display: none;
  }

  .plan-price {
    font-size: 32px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .plan-price span {
    font-size: 14px;
    font-weight: 400;
    color: var(--text-tertiary);
  }

  .plan-desc {
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-secondary);
    flex: 1;
  }

  /* Footer */
  .footer {
    border-top: 1px solid var(--color-border-default);
    padding: 32px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: var(--text-tertiary);
  }
</style>
