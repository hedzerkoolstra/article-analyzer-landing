---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrowserCTA from '../components/BrowserCTA.astro';
// import LeaderboardTable from '../components/LeaderboardTable.astro';
import InteractiveDemo from '../components/demo/InteractiveDemo.astro';
import PricingCard from '../components/PricingCard.astro';
import SectionLabel from '../components/SectionLabel.astro';
// import { outlets } from '../data/fixtures';
---

<BaseLayout
  title="Capito — propaganda analysis for the article you're reading"
  description="Propaganda analysis for online articles. Every article gets its own score and the techniques behind it are named."
>
  {/* Leaderboard structured data — restore together with the leaderboard section
  <slot name="head" slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Capito outlet scores",
      "description": "News outlets ranked by propaganda technique density. Rolling 6-month window, updated weekly.",
      "itemListElement": outlets.slice(0, 10).map((o, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": o.name,
        "url": `https://capito.news/outlets/${o.slug}`,
      })),
    })} />
  </slot>
  */}

  <!-- Product hero -->
  <section class="hero">
    <h1 class="hero-headline">Propaganda is everywhere.</h1>
    <p class="hero-sub">See it with Capito. Analyze any article on the web.</p>
    <BrowserCTA size="lg" />
  </section>

  <!-- Value propositions -->
  <section class="values">
    <div class="value">
      <h2>Run anywhere</h2>
      <p>Check any article from any outlet you read.</p>
    </div>
    <div class="value">
      <h2>Analyze without bias</h2>
      <p>No political axis. Only technique.</p>
    </div>
    <div class="value">
      <h2>Build understanding</h2>
      <p>Learn how propaganda is applied.</p>
    </div>
  </section>

  {/* Leaderboard — not shipping yet, restore with the imports and structured data above
  <section class="leaderboard-section" id="leaderboard">
    <div class="leaderboard-head">
      <p class="leaderboard-eyebrow"><SectionLabel label="Outlet scores" /></p>
      <h2 class="leaderboard-heading">The worst offenders so far.</h2>
      <p class="leaderboard-intro">
        Every score comes from an article a reader chose to analyze. The analysis is
        the same one that runs in your browser.
      </p>
    </div>
    <LeaderboardTable outlets={outlets} />
  </section>
  */}

  <!-- How it works -->
  <section class="how" id="how-it-works">
    <div class="how-head">
      <p class="how-eyebrow"><SectionLabel label="How it works" /></p>
      <h2 class="how-heading">Analyze the article. Every play gets marked.</h2>
    </div>

    <InteractiveDemo />
  </section>

  <!-- Pricing -->
  <section class="pricing" id="pricing">
    <p class="section-eyebrow"><SectionLabel label="Pricing" /></p>
    <h2 class="pricing-heading">Every plan runs the full analysis.</h2>
    <div class="plans">
      <PricingCard
        name="Free"
        price="€0"
        description="3 articles per month. Full analysis every time."
        cta="Get started"
      />
      <PricingCard
        name="Plus"
        price="€4"
        period="/mo"
        description="30 articles per month. Past analyses are saved and searchable."
        cta="Get Plus"
        featured={true}
      />
      <PricingCard
        name="Pro"
        price="€16"
        period="/mo"
        description="300 articles per month."
        cta="Get Pro"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* Product hero */
  .hero {
    padding: 140px 0 140px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    border-bottom: 1px solid var(--color-border-default);
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(28px, 5vw, 56px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0;
  }

  .hero-sub {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 480px;
  }

  /* Leaderboard */
  .leaderboard-section {
    padding: 96px 0 0;
  }

  .leaderboard-head {
    margin-bottom: 40px;
  }

  .leaderboard-eyebrow {
    margin: 0 0 12px;
  }

  .leaderboard-heading {
    margin: 0 0 10px;
    font-size: 22px;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .leaderboard-intro {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 520px;
  }

  /* How it works */
  .how {
    padding: 96px 0;
    border-top: 1px solid var(--color-border-default);
  }

  .section-eyebrow {
    margin: 0 0 40px;
  }

  .how-head {
    margin-bottom: 40px;
  }

  .how-eyebrow {
    margin: 0 0 12px;
  }

  .how-heading {
    margin: 0;
    font-size: 22px;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  /* Value propositions */
  .values {
    padding: 96px 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 88px;
  }

  .value {
    position: relative;
  }

  .value + .value::before {
    content: '';
    position: absolute;
    left: -44px;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--color-border-default);
  }

  .value h2 {
    margin: 0 0 14px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .value p {
    margin: 0;
    font-size: 13px;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  /* Pricing */
  .pricing {
    padding-bottom: 128px;
  }

  .pricing-heading {
    margin: 0 0 28px;
    font-size: 22px;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding: 88px 0 88px;
    }

    .leaderboard-section {
      padding-top: 64px;
    }

    .how {
      padding: 64px 0;
    }

    .values {
      padding: 64px 0;
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .value + .value::before {
      display: none;
    }

    .pricing {
      padding-bottom: 88px;
    }

    .plans {
      grid-template-columns: 1fr;
    }
  }
</style>
