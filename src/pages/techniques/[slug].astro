---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrowserCTA from '../../components/BrowserCTA.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import TypeTag from '../../components/TypeTag.astro';
import { taxonomy } from '../../data/fixtures';
import { techniqueContent } from '../../data/techniqueContent';
import type { TechniqueSubtype, TechniqueType } from '../../data/fixtures';

export async function getStaticPaths() {
  return taxonomy.flatMap((type) =>
    type.subtypes.map((sub) => ({
      params: { slug: sub.slug },
      props: { subtype: sub, parentType: type },
    }))
  );
}

interface Props {
  subtype: TechniqueSubtype;
  parentType: TechniqueType;
}

const { subtype, parentType } = Astro.props;
const content = techniqueContent[subtype.slug];

const subtypeLookup = Object.fromEntries(
  taxonomy.flatMap((t) => t.subtypes.map((s) => [s.slug, s.label]))
);

/** Split sentence into annotated parts for underline rendering. */
function annotate(sentence: string, triggers: string[]): { text: string; trigger: boolean }[] {
  const parts: { text: string; trigger: boolean }[] = [];
  let remaining = sentence;

  while (remaining.length > 0) {
    let firstIdx = Infinity;
    let firstTrigger = '';

    for (const t of triggers) {
      const idx = remaining.indexOf(t);
      if (idx !== -1 && idx < firstIdx) {
        firstIdx = idx;
        firstTrigger = t;
      }
    }

    if (!firstTrigger) {
      parts.push({ text: remaining, trigger: false });
      break;
    }

    if (firstIdx > 0) {
      parts.push({ text: remaining.slice(0, firstIdx), trigger: false });
    }
    parts.push({ text: firstTrigger, trigger: true });
    remaining = remaining.slice(firstIdx + firstTrigger.length);
  }

  return parts;
}

/** Split specimen text into before / highlighted / after. */
function splitSpecimen(specimen: string, highlight: string) {
  const idx = specimen.indexOf(highlight);
  if (idx === -1) return { before: specimen, mid: '', after: '' };
  return {
    before: specimen.slice(0, idx),
    mid: highlight,
    after: specimen.slice(idx + highlight.length),
  };
}

const specimenParts = splitSpecimen(content.specimen, content.specimenHighlight);
const dissectionParts = annotate(content.dissectionSentence, content.triggers);

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Techniques", "item": "https://capito.news/techniques" },
    { "@type": "ListItem", "position": 2, "name": subtype.label, "item": `https://capito.news/techniques/${subtype.slug}` },
  ],
};
---

<BaseLayout
  title={`${subtype.label} — Definition and Examples | Capito`}
  description={subtype.definition}
>
  <slot name="head" slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </slot>

  <article class="technique-page">

    <!-- Page header -->
    <header class="page-header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/techniques" class="breadcrumb-link">Techniques</a>
        <span class="breadcrumb-sep">/</span>
        <TypeTag typeSlug={parentType.typeSlug} typeLabel={parentType.typeLabel} />
      </nav>
      <h1 class="page-title">{subtype.label}</h1>
      <p class="page-def">{subtype.definition}</p>
    </header>

    <!-- Specimen -->
    <section class="section">
      <p class="section-label-wrap"><SectionLabel label="Specimen" /></p>
      <div class="specimen-layout">
        <div class="specimen-article">
          <p class="specimen-text">
            {specimenParts.before && <span>{specimenParts.before}</span>}
            {specimenParts.mid && <mark class="specimen-highlight">{specimenParts.mid}</mark>}
            {specimenParts.after && <span>{specimenParts.after}</span>}
          </p>
          <p class="specimen-note">Fabricated passage — teaching example designed for clarity.</p>
        </div>
        <div class="specimen-finding">
          <div class="finding-head">
            <TypeTag typeSlug={parentType.typeSlug} typeLabel={parentType.typeLabel} />
            <span class="slash">/</span>
            <span class="subtype-plain">{subtype.label.toLowerCase()}</span>
          </div>
          <p class="finding-label">{content.specimenLabel}</p>
        </div>
      </div>
    </section>

    <!-- Dissection -->
    <section class="section">
      <p class="section-label-wrap"><SectionLabel label="Dissection" /></p>
      <div class="dissection-layout">
        <p class="dissection-sentence">
          {dissectionParts.map((part) =>
            part.trigger
              ? <mark class="trigger-mark">{part.text}</mark>
              : <span>{part.text}</span>
          )}
        </p>
        <ul class="margin-notes">
          {content.marginNotes.map((note) => (
            <li class="margin-note">{note}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Field notes -->
    <section class="section">
      <p class="section-label-wrap"><SectionLabel label="Field notes" /></p>
      <dl class="field-notes">
        <div class="field-row">
          <dt class="field-key">Family</dt>
          <dd class="field-val">
            <TypeTag typeSlug={parentType.typeSlug} typeLabel={parentType.typeLabel} />
          </dd>
        </div>
        <div class="field-row">
          <dt class="field-key">Habitat</dt>
          <dd class="field-val field-text">{content.habitat}</dd>
        </div>
        <div class="field-row">
          <dt class="field-key">Frequency</dt>
          <dd class="field-val field-text">found in {subtype.frequency} of analyzed articles</dd>
        </div>
        <div class="field-row">
          <dt class="field-key">Confused with</dt>
          <dd class="field-val field-text">
            {content.confusedWith.map((slug, i) => (
              <>
                <a href={`/techniques/${slug}`} class="confused-link">{subtypeLookup[slug]}</a>
                {i < content.confusedWith.length - 1 && <span class="comma">, </span>}
              </>
            ))}
          </dd>
        </div>
      </dl>
    </section>

    <!-- In the wild -->
    <section class="section">
      <p class="section-label-wrap"><SectionLabel label="In the wild" /></p>
      <div class="wild-cards">
        {content.inTheWild.map((item) => (
          <div class="wild-card">
            <blockquote class="wild-quote">"{item.quote}"</blockquote>
            <p class="wild-context">{item.context}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Why it works -->
    <section class="section">
      <p class="section-label-wrap"><SectionLabel label="Why it works" /></p>
      <p class="why-text">{content.whyItWorks}</p>
    </section>

    <!-- Counter-move -->
    <section class="section">
      <p class="section-label-wrap"><SectionLabel label="Counter-move" /></p>
      <p class="counter-move">
        <span class="counter-pip" aria-hidden="true" />
        {content.counterMove}
      </p>
    </section>

    <!-- Bridge CTA -->
    <section class="bridge">
      <p class="bridge-line">See it flagged in real articles while you read.</p>
      <BrowserCTA size="lg" />
    </section>

  </article>
</BaseLayout>

<style>
  .technique-page {
    padding-bottom: 80px;
  }

  /* Header */
  .page-header {
    padding: 56px 0 48px;
    border-bottom: 0.5px solid var(--color-border-default);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .breadcrumb-link {
    font-size: 12px;
    color: var(--text-tertiary);
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    color: var(--text-secondary);
  }

  .breadcrumb-sep {
    font-size: 11px;
    color: var(--text-tertiary);
    opacity: 0.4;
  }

  .page-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(40px, 5vw, 60px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0 0 12px;
  }

  .page-def {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 520px;
  }

  /* Sections */
  .section {
    padding: 36px 0;
    border-bottom: 0.5px solid var(--color-border-default);
  }

  .section-label-wrap {
    margin: 0 0 20px;
  }

  /* Specimen */
  .specimen-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 32px;
    align-items: start;
  }

  .specimen-article {
    background: var(--color-surface-deep);
    border: 0.5px solid var(--color-border-strong);
    border-radius: 10px;
    padding: 20px 24px;
  }

  .specimen-text {
    margin: 0 0 12px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .specimen-highlight {
    background: rgba(255, 216, 77, 0.10);
    border-bottom: 0.5px solid rgba(255, 216, 77, 0.40);
    border-radius: 2px;
    color: var(--text-primary);
    padding: 0 1px;
    font-style: normal;
  }

  .specimen-note {
    margin: 0;
    font-size: 10px;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  .specimen-finding {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    background: var(--color-surface-deep);
    border: 0.5px solid var(--color-border-strong);
    border-radius: 10px;
  }

  .finding-head {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .slash {
    font-size: 10px;
    color: var(--text-tertiary);
    opacity: 0.35;
  }

  .subtype-plain {
    font-size: 11px;
    color: var(--text-tertiary);
    font-weight: 300;
  }

  .finding-label {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-tertiary);
  }

  /* Dissection */
  .dissection-layout {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 48px;
    align-items: start;
  }

  .dissection-sentence {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(17px, 2vw, 22px);
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .trigger-mark {
    background: none;
    text-decoration: underline;
    text-decoration-color: rgba(255, 216, 77, 0.55);
    text-decoration-thickness: 0.5px;
    text-underline-offset: 3px;
    color: var(--text-primary);
    font-style: italic;
  }

  .margin-notes {
    list-style: none;
    margin: 6px 0 0;
    padding: 0 0 0 16px;
    border-left: 0.5px solid var(--color-border-default);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .margin-note {
    font-size: 11px;
    line-height: 1.5;
    color: var(--text-tertiary);
  }

  /* Field notes */
  .field-notes {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
  }

  .field-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    align-items: center;
    padding: 10px 0;
    border-bottom: 0.5px solid var(--color-border-default);
  }

  .field-row:last-child {
    border-bottom: none;
  }

  .field-key {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .field-val {
    display: flex;
    align-items: center;
  }

  .field-text {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .confused-link {
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 2px;
  }

  .confused-link:hover {
    color: var(--text-primary);
  }

  .comma {
    color: var(--text-tertiary);
  }

  /* In the wild */
  .wild-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .wild-card {
    background: var(--color-surface-deep);
    border: 0.5px solid var(--color-border-strong);
    border-radius: 10px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .wild-quote {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .wild-context {
    margin: 0;
    font-size: 10px;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  /* Why it works */
  .why-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 600px;
  }

  /* Counter-move */
  .counter-move {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-primary);
    font-weight: 500;
  }

  .counter-pip {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent-yellow);
    box-shadow: 0 0 6px var(--color-accent-yellow-focus);
    flex-shrink: 0;
  }

  /* Bridge */
  .bridge {
    padding: 56px 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .bridge-line {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    font-weight: 400;
    color: var(--text-secondary);
    max-width: 480px;
    line-height: 1.3;
  }

  /* Responsive */
  @media (max-width: 720px) {
    .specimen-layout {
      grid-template-columns: 1fr;
    }

    .dissection-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .margin-notes {
      border-left: none;
      padding-left: 0;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px;
    }

    .margin-note::after {
      content: ' ·';
      opacity: 0.4;
    }

    .margin-note:last-child::after {
      content: '';
    }

    .wild-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
